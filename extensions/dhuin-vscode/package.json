{
    "name": "dhuin-vscode",
    "displayName": "DHUIN Language Support",
    "description": "Syntax highlighting and language support for DHUIN (Declarative Hybrid Universal Instruction Language)",
    "version": "0.1.0",
    "publisher": "dhuin",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "dhuin",
                "aliases": [
                    "DHUIN",
                    "dhuin"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "dhuin",
                "scopeName": "text.html.markdown.dhuin",
                "path": "./syntaxes/dhuin.tmLanguage.json"
            },
            {
                "scopeName": "markdown.dhuin.injection",
                "path": "./syntaxes/dhuin.injection.tmLanguage.json",
                "injectTo": [
                    "text.html.markdown",
                    "text.html.markdown.dhuin"
                ]
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "entity.name.section.block-title.dhuin",
                        "settings": {
                            "foreground": "#fa8181"
                        }
                    },
                    {
                        "scope": "entity.name.section.rule-classification.dhuin",
                        "settings": {
                            "foreground": "#ffe1b6"
                        }
                    },
                    {
                        "scope": "keyword.control.conditional.dhuin",
                        "settings": {
                            "foreground": "#daffbe"
                        }
                    },
                    {
                        "scope": "entity.name.function.action.dhuin",
                        "settings": {
                            "foreground": "#72b1b9"
                        }
                    },
                    {
                        "scope": "storage.modifier.policy.dhuin",
                        "settings": {
                            "foreground": "#FFAB91"
                        }
                    },
                    {
                        "scope": "keyword.other.metadata.dhuin",
                        "settings": {
                            "foreground": "#FFE082"
                        }
                    }
                ]
            }
        }
    }
}
